      "pages": [27],
      "taughtInClass": true,
      "tip": "Family words have irregular plurals: et barn – børn, en datter – døtre, en søn – sønner, en søster – søstre, en bror – brødre.\nBig and little siblings: en storebror, en lillebror (two words: to små brødre for plural little brothers).",
      "items": [
        { "id": "u04-p27-aegtepar", "kind": "word", "da": "et ægtepar", "en": "married couple", "alt": { "en": ["couple"] }, "gender": "et", "forms": ["ægteparret", "ægtepar", "ægteparrene"],
          "sentences": [ { "da": "De er et ægtepar.", "en": "They are a married couple.", "gap": "ægtepar" } ] },
        { "id": "u04-p27-mor", "kind": "word", "da": "en mor", "en": "mother", "alt": { "en": ["mum", "mom"] }, "gender": "en", "forms": ["moren", "mødre", "mødrene"],
