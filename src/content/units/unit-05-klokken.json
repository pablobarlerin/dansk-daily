    {
      "id": "u05-l02",
      "title": "Digital and analog time",
      "pages": [30],
      "taughtInClass": true,
      "tip": "Around the half hour you count from halv: 9 minutter i halv 9 = 8:21, 2 minutter over halv 9 = 8:32.\nDigital time uses 0-24 and is exact: kl. 8:15 = kl. otte femten, kl. 13:00 = kl. tretten nul nul. Analog time uses 0-12, so add om + the part of the day (definite): kl. et om eftermiddagen, kl. halv tolv om formiddagen.",
      "items": [],
      "repeatLines": [
        { "da": "Den er ni minutter i halv ni.", "en": "It is 8:21 (nine minutes to half past eight)." },
        { "da": "Den er to minutter over halv ni.", "en": "It is 8:32 (two minutes past half past eight)." },
        { "da": "Klokken tyve nul ni.", "en": "20:09 (digital time)." },
        { "da": "Klokken ni minutter over otte om aftenen.", "en": "Nine minutes past eight in the evening (20:09, analog time)." },
        { "da": "Klokken kvart over otte om morgenen.", "en": "Quarter past eight in the morning." },
        { "da": "Klokken kvart i to om natten.", "en": "Quarter to two at night." }
