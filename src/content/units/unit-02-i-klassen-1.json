    {
      "id": "u02-l05",
      "title": "Whose is it? Mine, yours, his, hers",
      "pages": [15],
      "taughtInClass": false,
      "tip": "Possessives match the noun: min/din + en-word (min bog), mit/dit + et-word (mit hæfte), plural mine/dine.\nhans, hendes never change; vores (our), jeres (your, plural), deres (their).\nAdd -s to a name to say whose: Det er Sofies.",
      "items": [
        { "id": "u02-p15-hvis-jakke-er-det", "kind": "phrase", "da": "Hvis jakke er det?", "en": "Whose jacket is it?",
          "sentences": [ { "da": "Det er Marias.", "en": "It's Maria's.", "gap": "Marias" } ] },
        { "id": "u02-p15-er-det-din-jakke", "kind": "phrase", "da": "Er det din jakke?", "en": "Is it your jacket?", "alt": { "en": ["Is this your jacket?", "Is that your jacket?"] },
          "sentences": [ { "da": "Nej, det er ikke min jakke.", "en": "No, it's not my jacket.", "gap": "min" } ] },
        { "id": "u02-p15-hvis-er-det-saa", "kind": "phrase", "da": "Hvis er det så?", "en": "Whose is it then?",
          "sentences": [ { "da": "Det er Sofies.", "en": "It's Sofie's.", "gap": "Sofies" }, { "da": "Det er skolens.", "en": "It's the school's.", "gap": "skolens" } ] },
        { "id": "u02-p15-er-det-dit-viskelaeder", "kind": "phrase", "da": "Er det dit viskelæder?", "en": "Is it your eraser?", "alt": { "en": ["Is this your eraser?", "Is that your eraser?"] },
          "sentences": [ { "da": "Nej, det er ikke mit viskelæder.", "en": "No, it's not my eraser.", "gap": "mit" } ] },
        { "id": "u02-p15-er-det-runes-bog", "kind": "phrase", "da": "Er det Runes bog?", "en": "Is it Rune's book?",
          "sentences": [ { "da": "Nej, det er ikke hans.", "en": "No, it's not his.", "gap": "hans" } ] },
        { "id": "u02-p15-er-det-lones-ur", "kind": "phrase", "da": "Er det Lones ur?", "en": "Is it Lone's watch?",
          "sentences": [ { "da": "Nej, det er ikke hendes.", "en": "No, it's not hers.", "gap": "hendes" } ] },
        { "id": "u02-p15-det-ved-jeg-ikke", "kind": "phrase", "da": "Det ved jeg ikke.", "en": "I don't know.", "alt": { "en": ["I do not know."] },
          "sentences": [ { "da": "Det ved jeg ikke.", "en": "I don't know.", "gap": "ved" } ] },
        { "id": "u02-p15-jeg-tror-det-er", "kind": "phrase", "da": "Jeg tror, det er skolens.", "en": "I think it's the school's.", "alt": { "en": ["I think it is the school's."] },
