        { "id": "u02-p15-ja-maaske", "kind": "phrase", "da": "Ja, måske.", "en": "Yes, maybe.", "alt": { "en": ["Yes, perhaps."] },
          "sentences": [ { "da": "Ja, måske.", "en": "Yes, maybe.", "gap": "måske" } ] },
        { "id": "u02-p15-det-er-peters-eller-ullas", "kind": "phrase", "da": "Det er Peters eller Ullas.", "en": "It's Peter's or Ulla's.",
          "sentences": [ { "da": "Det er Peters eller Ullas.", "en": "It's Peter's or Ulla's.", "gap": "eller" } ] },
        { "id": "u02-p15-det-er-min-bog", "kind": "pattern", "da": "Det er min bog.", "en": "It's my book.",
